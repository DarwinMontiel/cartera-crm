<% content_for :title, "Nueva contraseña" %>
<section class="auth">
  <div class="auth__card">
    <h1>Nueva contraseña</h1>
    <%= form_with url: password_path(params[:token]), method: :put, class: "form" do |form| %>
      <div class="field">
        <%= form.label :password, "Contraseña (mínimo 10 caracteres)" %>
        <%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 10, maxlength: 72 %>
      </div>
      <div class="field">
        <%= form.label :password_confirmation, "Repite la contraseña" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
      </div>
      <%= form.submit "Guardar", class: "btn btn--primary btn--block" %>
    <% end %>
  </div>
</section>
